# Server-only settings. Set them in Vercel's project settings, never in code.
# The waitlist (app/api/waitlist) needs the first three; without them it answers "Sign-ups aren't open on this site yet.".
# The service role key is also how the join page moves an under-13 player's invite to a parent (lib/supabase/admin.ts).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard -> Project Settings -> API keys -> secret (service role) key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to scramble visitors' network addresses before the rate limit sees them.
WAITLIST_IP_SALT=

# Signed-in pages (/login, /app, /join): read at request time on the server. Publishable key from the same API keys page.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The same two for any client component that talks to Supabase directly (none yet); fixed at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
