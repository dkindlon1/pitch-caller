# Server-only settings. Set them in Vercel's project settings, never in code.
# The waitlist (app/api/waitlist) needs the first three; without them it answers "Sign-ups aren't open on this site yet.".
# The service role key is also how the join page moves an under-13 player's invite to a parent (lib/supabase/admin.ts).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard -> Project Settings -> API keys -> secret (service role) key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to scramble visitors' network addresses before the rate limit sees them.
WAITLIST_IP_SALT=

# Signed-in pages (/login, /app, /join): read at request time on the server. Publishable key from the same API keys page.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The same two for any client component that talks to Supabase directly (none yet); fixed at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Billing (Plan 2, docs/plans/2026-11-05-pitchiq-billing.md). Test-mode keys first. Server only.
STRIPE_SECRET_KEY=sk_test_...
# The webhook endpoint's signing secret (Stripe dashboard -> Webhooks -> the /api/stripe/webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# The yearly per-team price, the first-year coupon (duration "once"), and the billing portal configuration
STRIPE_PRICE_ID=price_...
STRIPE_COUPON_ID=
STRIPE_PORTAL_CONFIG=bpc_...
# Where Checkout and the portal send people back to, e.g. https://pitchiq.example
SITE_URL=
# Tests only (web/tests/fake_stripe.js); ignored unless the key is a test key. Never set in Vercel.
# STRIPE_FAKE_API=http://localhost:12111

# Email (Plan 2b: the lapse exports' download links). Server only. Without a key nothing is emailed, and each person
# downloads theirs from /app/exports. Until a domain is verified in Resend, it sends only from onboarding@resend.dev
# and only to the Resend account's own address.
RESEND_API_KEY=
EMAIL_FROM=PitchIQ <data@your-verified-domain>
# Tests only (web/tests/fake_resend.js); ignored unless the key starts with re_test_. Never set in Vercel.
# RESEND_FAKE_API=http://127.0.0.1:12112
