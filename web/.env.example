# Server-only settings for the waitlist API (app/api/waitlist). Set them in Vercel's project settings, never in code.
# Without all three the form answers "Sign-ups aren't open on this site yet." and stores nothing.
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard -> Project Settings -> API keys -> secret (service role) key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to scramble visitors' network addresses before the rate limit sees them.
WAITLIST_IP_SALT=
