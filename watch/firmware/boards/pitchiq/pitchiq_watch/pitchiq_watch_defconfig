CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y

# ASSUMPTION: the MDBT50Q module has its 32.768 kHz crystal fitted (rev B BOM), so the low-frequency clock is the XTAL.
# If the crystal is missing the nRF52 clock driver spins forever at boot waiting for it.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

# No UART and no USB on this board: logging goes over SEGGER RTT (J-Link). The application turns on the RTT log
# backend; the console is not used.
CONFIG_USE_SEGGER_RTT=y
CONFIG_SERIAL=n
CONFIG_CONSOLE=n
CONFIG_UART_CONSOLE=n
