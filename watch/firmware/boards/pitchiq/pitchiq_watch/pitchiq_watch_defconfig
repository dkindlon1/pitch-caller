CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y

# ASSUMPTION: the MDBT50Q module has its 32.768 kHz crystal fitted (rev B BOM), so the low-frequency clock is the XTAL.
# If the crystal is missing the nRF52 clock driver spins forever at boot waiting for it (the system timer starts the LF
# clock in STABLE mode, drivers/timer/nrf_rtc_timer.c).  NOT changed.  What exists in Zephyr v4.4.2 if it ever has to be:
#   CONFIG_SYSTEM_CLOCK_WAIT_FOR_AVAILABILITY=y  keeps the XTAL source, boots as soon as the internal RC (two-stage start)
#       runs, and switches to the XTAL whenever it is ready; with a dead crystal the watch runs on the RC for ever (the
#       declared sleep-clock accuracy stays at the XTAL's 50 ppm, so connections could drop: untested).
#   CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y  (calibration CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION defaults on, needs the
#       HFXO node, period 4 s) replaces the XTAL source with the RC; accuracy then defaults to 500 ppm on nRF52, which the
#       Bluetooth controller needs to be told (CONFIG_CLOCK_CONTROL_NRF_ACCURACY follows automatically).
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y

# No UART and no USB on this board: logging goes over SEGGER RTT (J-Link). The application turns on the RTT log
# backend; the console is not used.
CONFIG_USE_SEGGER_RTT=y
CONFIG_SERIAL=n
CONFIG_CONSOLE=n
CONFIG_UART_CONSOLE=n
