/*
 * PitchIQ watch rev D: nRF52840 (QIAA) in a Raytac MDBT50Q module, Sharp memory LCD, LIS2DH12, nPM1300 (no heart-rate sensor, no 5 V boost).
 * Pin numbers live in pitchiq_watch-pinctrl.dtsi (PQ_PIN_*); this file refers to them by name.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "pitchiq_watch-pinctrl.dtsi"
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/regulator/npm13xx.h>
#include <zephyr/dt-bindings/sensor/lis2dh.h>

/ {
	model = "PitchIQ watch rev D";
	compatible = "pitchiq,watch-rev-c";

	chosen {
		/* No console and no shell: logging is SEGGER RTT only (see the defconfig).  The LCD is the display. */
		zephyr,display = &lcd;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	/* Things the application finds through DT_PATH(zephyr_user): they are not worth a driver node of their own. */
	zephyr,user {
		/* Frontlight LED, active high, PWM0 channel 0 on PQ_PIN_LIGHT_PWM.  1 kHz.
		 * ASSUMPTION: the LED sits behind a transistor that is on when the pin is high (flagged in the schematic as
		 * "active high"); no flicker problem at 1 kHz for a still LED; the duty chosen in ui.c is a guess to tune. */
		/* Vibration motor, active high, low-side MOSFET, PWM1 channel 0 on PQ_PIN_MOTOR_PWM.  20 kHz so it is quiet.
		 * (Both are entries of one "pwms" property, named "light" and "motor": a custom "<name>-pwms" needs its own cells name.)
		 * Rev C: the motor is an 8 mm coin ERM (rev B had a 10 mm part), same drive circuit.  It is wired from VSYS, NOT the
		 * 3.0 V rail: VSYS is about 3.1-4.2 V on battery and about 5 V when VBUS is present (USB Type-C).
		 * haptics.c caps the PWM duty to give about 3.0 V effective (scaled by the last battery sample, lower again when VBUS
		 * is present).  A flyback diode is fitted across it.
		 * ASSUMPTION: the 8 mm part is also rated 3 V (carried over from the 10 mm part's cap, check its datasheet), and
		 * neither the duty cap nor the diode can be checked from firmware. */
		pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
		       <&pwm1 0 PWM_USEC(50) PWM_POLARITY_NORMAL>;
		pwm-names = "light", "motor";
		/* LCD DISP (P0.22), active high.  Deliberately NOT given to the ls0xx driver (no disp-en-gpios there): that
		 * driver raises DISP before it sends the all-clear, but the LS013B7DH03 needs the memory cleared first or it
		 * shows random pixels.  Without the property the driver clears the panel at init and leaves DISP alone; ui_init()
		 * then raises it.  Needs the panel to confirm the order. */
		lcd-disp-gpios = <&gpio0 PQ_PIN_LCD_DISP GPIO_ACTIVE_HIGH>;
	};

	aliases {
		watchdog0 = &wdt0;
		accel0 = &accel;
	};
};

&reg1 {
	/* REG1 is the nRF52840 DC/DC regulator for the stage 1.  Enabled (the inductor is in the module).  ASSUMPTION: the
	 * module's DC/DC inductor and capacitor are fitted: the MDBT50Q has them. */
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uicr {
	/* ASSUMPTION: P0.18 is brought out to the SWD programming pads (SWD only on rev C, no charge pad) as nRESET, as on the MDBT50Q reference design. */
	gpio-as-nreset;
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	/* Accelerometer.  ASSUMPTION: SA0 is tied high (address 0x19), INT1 is the only interrupt line wired, and
	 * the part sits on the always-on 3.0 V rail (BUCK2). */
	accel: lis2dh12@19 {
		compatible = "st,lis2dh12", "st,lis2dh";
		reg = <0x19>;
		irq-gpios = <&gpio0 PQ_PIN_ACCEL_INT1 GPIO_ACTIVE_HIGH>;
		anym-on-int1;
	};

	/* nPM1300 power management chip.  BUCK2 is the system rail.  The user button is wired to its SHPHLD pin, so a
	 * press arrives as an nPM1300 event on the host interrupt line, not as a GPIO key. */
	npm1300_pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		/* ASSUMPTION: nPM1300 GPIO1 is the pin routed to the nRF52840 P0.06 as the interrupt output. */
		pmic-int-pin = <1>;
		host-int-gpios = <&gpio0 PQ_PIN_PMIC_INT GPIO_ACTIVE_HIGH>;
		/* Ship mode: a press of at least this long on SHPHLD wakes the part from ship mode (power_ship() in
		 * power.c enters it).  1 s so a stray touch does not turn the watch on. */
		ship-to-active-time-ms = <1008>;
		/* Holding the button this long with the firmware hung power-cycles the watch (hardware, not firmware).  The
		 * firmware's own 5 s "forget pairing" gesture is shorter, so they do not collide. */
		long-press-reset = "one-button";

		npm1300_regulators: regulators {
			compatible = "nordic,npm1300-regulator";

			/* BUCK1 is NOT used and deliberately has NO node here. VSET1 is tied to ground, so the chip leaves
			 * BUCK1 off at start-up, and rev D fits no inductor or output capacitor on it (as in Nordic's one-buck
			 * reference configuration): pins VOUT1 and SW1 are open. Never enable it. Because no BUCK1 child node
			 * exists, the regulator driver does not initialise it and the application cannot look it up
			 * (nothing in app/ refers to buck1). */

			/* System rail 3.0 V, always on: set at start-up by a 150 k resistor on VSET2, the nRF52840 is already
			 * running from it before this code executes; the firmware only confirms it.  The PMIC's VDDIO is tied to
			 * this rail. */
			buck2: BUCK2 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-init-microvolt = <3000000>;
				regulator-always-on;
			};
		};

		/* 150 mAh cell: 4.20 V termination, 75 mA charge current (0.5 C), 10 k NTC.
		 * The nPM1300 comes up with charging OFF, charge current 32 mA and the VBUS input limit 100 mA.  The Zephyr
		 * charger driver writes the values below and sets the enable bit at its init, so charging is configured at
		 * every boot, in firmware, with no other code needed.  A flat battery still recovers: VBUS feeds VSYS
		 * through the PMIC power path, so the MCU boots from cable power alone and then runs this init. Until it does,
		 * the chip's defaults (32 mA, 100 mA) apply and nothing charges, which is safe.
		 * ASSUMPTION: the NTC beta is 3380 K (typical for the 10 k part, check the datasheet of the fitted one).
		 * Rev C: charging is through a USB Type-C receptacle, CC1/CC2 straight to the nPM1300 (internal 5.1 k Rd).  The
		 * input limit stays at the chip default of 100 mA (default USB) until power.c has read the USB-C detect status
		 * register and seen a source that advertises 1.5 A or 3 A; only then does it write 500 mA (power.c).  The
		 * vbus-limit-microamp below is the start-up limit (VBUSINILIMSTARTUP), so it must stay 100 mA. */
		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			term-microvolt = <4200000>;
			term-warm-microvolt = <4000000>;
			current-microamp = <75000>;
			/* 1 A (the nPM1300 high setting): the 200 mA low setting is below the 150-240 mA worst case (motor + radio + LED)
			 * and a trip browns the system out.  Firmware review 6.  power.c DISCHG_LIMIT must match. */
			dischg-limit-microamp = <1000000>;
			vbus-limit-microamp = <100000>;
			thermistor-ohms = <10000>;
			thermistor-beta = <3380>;
			charging-enable;
		};
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	/* SCS is active high. */
	cs-gpios = <&gpio0 PQ_PIN_LCD_SCS GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	lcd: ls013b7dh03@0 {
		compatible = "sharp,ls0xx";
		reg = <0>;
		spi-max-frequency = <1000000>;
		width = <128>;
		height = <128>;
		/* Datasheet: EXTCOMIN must be 54..65 Hz for this panel, SCLK at most 1.1 MHz, SCS active high, EXTMODE
		 * strapped high on the board (so EXTCOMIN, not the serial VCOM bit, does the inversion).  The driver toggles
		 * EXTCOMIN on its own thread. */
		extcomin-gpios = <&gpio0 PQ_PIN_LCD_EXTCOMIN GPIO_ACTIVE_HIGH>;
		extcomin-frequency = <60>;
	};
};

/* Frontlight. */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Vibration motor (own PWM instance because the period differs from the frontlight's). */
&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * Internal 1 MB flash for MCUboot with swap-using-move, no scratch partition:
 *   0x00000  boot      48 KB   MCUboot
 *   0x0c000  slot0    480 KB   running image
 *   0x84000  slot1    480 KB   update image (same size; swap-using-move needs the primary slot's last sector)
 *   0xfc000  storage   16 KB   settings (NVS, 4 x 4 KB sectors): Bluetooth bonds; does not overlap the slots (slot1 ends at 0xfc000)
 */
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 0x0000c000>;
		};

		slot0_partition: partition@c000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x0000c000 0x00078000>;
		};

		slot1_partition: partition@84000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00084000 0x00078000>;
		};

		storage_partition: partition@fc000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000fc000 0x00004000>;
		};
	};
};
